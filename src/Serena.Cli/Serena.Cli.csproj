<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Serena.Cli</RootNamespace>
    <AssemblyName>serena</AssemblyName>
    <Description>Serena - A code-aware MCP coding agent with LSP integration for .NET</Description>

    <!-- .NET Tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>serena-dotnet</ToolCommandName>
    <PackageId>Serena.DotNet</PackageId>
    <Version>0.2.1</Version>
    <Authors>dgerman</Authors>
    <PackageDescription>A .NET-first MCP coding agent inspired by oraios/serena. Ships as a .NET global tool with 38 tools for navigating, understanding, and editing code. Features an indexed SQLite symbol cache, solution-scoped indexing for large repositories, lazy language-server startup, explicit Roslyn readiness/completeness telemetry, outline-first responses, and 13 language-server backends.</PackageDescription>
    <PackageTags>mcp;coding-agent;lsp;roslyn;csharp;ai-tools;serena;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/d-german/serena-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/d-german/serena-dotnet</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/d-german/serena-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Serena.Core\Serena.Core.csproj" />
    <ProjectReference Include="..\Serena.Mcp\Serena.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0-preview.*" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
